# Copie este arquivo para `.env` e preencha com as credenciais do seu projeto
# Supabase (Dashboard -> Project Settings -> API).
#
# Apenas configuracao publica pode ficar aqui: o `.env` e empacotado como asset
# do app e, num build web, fica acessivel em /assets/.env. Segredos de verdade
# (service role key, tokens de terceiros) pertencem a uma Edge Function.

SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sua-anon-key-aqui
